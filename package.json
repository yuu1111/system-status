{
	"name": "system-vitals",
	"version": "1.0.1",
	"description": "Cross-platform CPU, memory, disk, and GPU status collection for Node.js and Bun",
	"type": "module",
	"license": "MIT",
	"author": "yuu1111",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/system-vitals.git"
	},
	"bugs": {
		"url": "https://github.com/yuu1111/system-vitals/issues"
	},
	"homepage": "https://github.com/yuu1111/system-vitals#readme",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"README.ja.md"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc -p tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write --unsafe .",
		"test": "bun test",
		"test:node": "npm run build && node scripts/smoke.mjs",
		"prepack": "npm run build"
	},
	"keywords": [
		"system",
		"gpu",
		"nvidia",
		"amd",
		"monitoring"
	],
	"packageManager": "bun@1.3.14",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/bun": "^1.4.0",
		"typescript": "^7.0.2"
	}
}
